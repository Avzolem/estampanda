# -----------------------------------------------------------------------------
# NextAuth: https://shipfa.st/docs/tutorials/user-auth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Google OAuth: https://shipfa.st/docs/features/google-oauth
# -----------------------------------------------------------------------------
GOOGLE_ID=
GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Resend: https://shipfa.st/docs/features/emails
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Database URI: https://shipfa.st/docs/features/database
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Stripe: https://shipfa.st/docs/features/payments
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Cloudinary: Para almacenamiento y procesamiento de imágenes
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=estampanda-stickers

# -----------------------------------------------------------------------------
# Estampanda Configuración adicional
# -----------------------------------------------------------------------------
# Email para notificaciones de pedidos
ADMIN_EMAIL=admin@estampanda.com
ORDER_NOTIFICATIONS_EMAIL=pedidos@estampanda.com

# Configuración de producción
PRODUCTION_MODE=development
ENABLE_RUSH_ORDERS=true

# API Keys para servicios adicionales (opcional)
REMOVE_BG_API_KEY=
SHIPPO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Configuración de almacenamiento local (desarrollo)
UPLOAD_DIR=/tmp/estampanda-uploads

# Configuración de seguridad
MAX_FILE_SIZE_MB=50
ALLOWED_DOMAINS=estampanda.com,localhost:3000

# Analytics (opcional)
GA_MEASUREMENT_ID=
HOTJAR_ID=
HOTJAR_SNIPPET_VERSION=