# -----------------------------------------------------------------------------
# Admin Auth (libs/simple-auth.js) — credenciales del único admin del panel
# -----------------------------------------------------------------------------
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# JWT Secret — usado por libs/simple-auth.js para firmar el token de sesión
# (el nombre NEXTAUTH_SECRET se mantiene por compatibilidad histórica;
# generar con: openssl rand -base64 32)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Database URI
# -----------------------------------------------------------------------------
MONGODB_URI=your_mongodb_uri_here

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Cloudinary: Para almacenamiento y procesamiento de imágenes
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=estampanda-stickers

# -----------------------------------------------------------------------------
# Estampanda Configuración adicional
# -----------------------------------------------------------------------------
# Email para notificaciones de pedidos
ADMIN_EMAIL=admin@estampanda.com
ORDER_NOTIFICATIONS_EMAIL=pedidos@estampanda.com

# Configuración de producción
PRODUCTION_MODE=development
ENABLE_RUSH_ORDERS=true

# Configuración de almacenamiento local (desarrollo)
UPLOAD_DIR=/tmp/estampanda-uploads

# Configuración de seguridad
MAX_FILE_SIZE_MB=50
ALLOWED_DOMAINS=estampanda.com,localhost:3000

# Analytics (opcional)
GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Cron secret — autoriza el job /api/cron/cleanup-expired (Vercel Cron)
# Generar con: openssl rand -base64 32
# -----------------------------------------------------------------------------
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
